{
  "name": "empress-blog-casper-template",
  "version": "6.0.0-next.0",
  "description": "Casper Template for empress-blog",
  "keywords": [
    "ember-addon",
    "ember-ghost",
    "ember-ghost-template",
    "empress-blog",
    "empress-blog-template"
  ],
  "repository": "https://github.com/empress/empress-blog-casper-template",
  "license": "MIT",
  "author": {
    "name": "Chris Manson",
    "email": "chris.mansona@simplabs.com"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "files": "dist",
  "release-plan": {
    "semverIncrementAs": {
      "major": "premajor",
      "minor": "prerelease",
      "patch": "prerelease"
    },
    "semverIncrementTag": "next",
    "publishTag": "next"
  },
  "scripts": {
    "build": "rollup --config",
    "ember-compatibility-test": "ember try:each",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "vite",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\"",
    "test:ember": "vite build --mode development && ember test --path dist",
    "prepare": "rollup --config",
    "prepack": "rollup --config",
    "prepublishOnly": "rollup --config"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9",
    "@nullvoxpopuli/ember-composable-helpers": "^5.3.0",
    "@responsive-image/ember": "^3.1.0",
    "autoprefixer": "^9.8.0",
    "cssnano": "^4.1.10",
    "decorator-transforms": "^2.2.2",
    "downsize-cjs": "^1.1.2",
    "ember-auto-import": "^2.8.1",
    "ember-cli-postcss": "^6.0.1",
    "ember-cli-showdown": "^10.0.0",
    "ember-modifier": "^4.3.0",
    "ember-responsive-image": "^3.1.1",
    "ember-route-template": "^1.0.3",
    "ember-truth-helpers": "^5.0.0",
    "empress-blog-ghost-helpers": "^1.2.0",
    "empress-blueprint-helpers": "^1.2.1",
    "postcss-color-function": "^4.1.0",
    "postcss-custom-properties": "^9.1.1",
    "postcss-easy-import": "^3.0.0",
    "rollup-plugin-postcss": "^4.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-proposal-decorators": "^7.24.7",
    "@ember/optional-features": "^2.1.0",
    "@ember/string": "^3.0.0",
    "@ember/test-helpers": "^5.2.1",
    "@embroider/addon-dev": "^8.1.0",
    "@embroider/compat": "^4.1.0",
    "@embroider/core": "^4.1.0",
    "@embroider/macros": "^1.20.1",
    "@embroider/test-setup": "^4.0.0",
    "@embroider/vite": "^1.1.5",
    "@eslint/js": "^9.38.0",
    "@glimmer/component": "^2.0.0",
    "@glimmer/tracking": "^1.1.2",
    "@rollup/plugin-babel": "^6.0.4",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^8.2.2",
    "ember-cli": "~5.12.0",
    "ember-cli-fastboot": "^4.1.5",
    "ember-data": "~5.3.0",
    "ember-inflector": "^6.0.0",
    "ember-load-initializers": "^2.1.2",
    "ember-page-title": "^8.2.3",
    "ember-qunit": "^9.0.2",
    "ember-resolver": "^12.0.1",
    "ember-source": "~5.12.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^7.9.3",
    "ember-try": "^4.0.0",
    "empress-blog": "^5.0.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ember": "^12.2.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-qunit": "^8.1.2",
    "globals": "^16.4.0",
    "lint-to-the-future": "^2.6.4",
    "lint-to-the-future-ember-template": "^3.1.0",
    "lint-to-the-future-eslint": "^3.2.0",
    "lint-to-the-future-stylelint": "^2.1.0",
    "prember": "^2.1.0",
    "prettier": "^3.3.3",
    "prettier-plugin-ember-template-tag": "^2.1.0",
    "qunit": "^2.22.0",
    "qunit-dom": "^3.2.1",
    "release-plan": "^0.17.2",
    "rollup": "^4.22.5",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-prettier": "^4.1.0",
    "vite": "^7.1.9"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "engines": {
    "node": ">= 18"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.34.4",
      "empress-blog-ghost-helpers": "link:../empress-blog-ghost-helpers"
    }
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "demoURL": "https://empress-blog-casper-template.netlify.com",
    "app-js": {
      "./components/byline-multiple.js": "./dist/_app_/components/byline-multiple.js",
      "./components/byline-single.js": "./dist/_app_/components/byline-single.js",
      "./components/floating-header.js": "./dist/_app_/components/floating-header.js",
      "./components/header.js": "./dist/_app_/components/header.js",
      "./components/navigation-links.js": "./dist/_app_/components/navigation-links.js",
      "./components/post-card.js": "./dist/_app_/components/post-card.js",
      "./components/site-nav.js": "./dist/_app_/components/site-nav.js",
      "./components/svg-icons/avatar.js": "./dist/_app_/components/svg-icons/avatar.js",
      "./components/svg-icons/facebook.js": "./dist/_app_/components/svg-icons/facebook.js",
      "./components/svg-icons/ghost-logo.js": "./dist/_app_/components/svg-icons/ghost-logo.js",
      "./components/svg-icons/infinity.js": "./dist/_app_/components/svg-icons/infinity.js",
      "./components/svg-icons/location.js": "./dist/_app_/components/svg-icons/location.js",
      "./components/svg-icons/point.js": "./dist/_app_/components/svg-icons/point.js",
      "./components/svg-icons/rss.js": "./dist/_app_/components/svg-icons/rss.js",
      "./components/svg-icons/twitter.js": "./dist/_app_/components/svg-icons/twitter.js",
      "./components/svg-icons/website.js": "./dist/_app_/components/svg-icons/website.js",
      "./components/templates/application.js": "./dist/_app_/components/templates/application.js",
      "./components/templates/author.js": "./dist/_app_/components/templates/author.js",
      "./components/templates/error.js": "./dist/_app_/components/templates/error.js",
      "./components/templates/index.js": "./dist/_app_/components/templates/index.js",
      "./components/templates/page.js": "./dist/_app_/components/templates/page.js",
      "./components/templates/post.js": "./dist/_app_/components/templates/post.js",
      "./components/templates/tag.js": "./dist/_app_/components/templates/tag.js",
      "./helpers/excerpt.js": "./dist/_app_/helpers/excerpt.js"
    }
  },
  "fastbootDependencies": [
    "crypto"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/styles.css",
    "./tests/*": "./tests/*",
    "./components/*": "./dist/components/*.js",
    "./*": "./src/*"
  }
}
